; Voxen — projet Godot 4 (voir gdd.md, Annexe D)
; Étape D.3.1 : GameData + 3 matériaux JSON + localisation + chunk plat texturé par bruit.

config_version=5

[application]

config/name="Voxen"
config/description="RPG voxel en monde infini procédural et continu."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7")

[autoload]

EventBus="*res://autoload/EventBus.gd"
GameData="*res://autoload/GameData.gd"
TickManager="*res://autoload/TickManager.gd"
SaveManager="*res://autoload/SaveManager.gd"
WorldManager="*res://autoload/WorldManager.gd"
CreatureManager="*res://autoload/CreatureManager.gd"
ClaimManager="*res://autoload/ClaimManager.gd"
ExplorationManager="*res://autoload/ExplorationManager.gd"
NetworkManager="*res://autoload/NetworkManager.gd"
DungeonManager="*res://autoload/DungeonManager.gd"
ShopManager="*res://autoload/ShopManager.gd"
DropManager="*res://autoload/DropManager.gd"
DayNightManager="*res://autoload/DayNightManager.gd"
BlockPreview="*res://autoload/BlockPreview.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[internationalization]

locale/translations=PackedStringArray("res://locale/fr.fr.translation", "res://locale/en.en.translation", "res://locale/ja.ja.translation", "res://locale/zh_Hans.zh_Hans.translation")
locale/fallback="en"

[rendering]

; Renderer Compatibility : la machine cible a un GPU intégré — Forward+ y
; plafonne sous 60 fps même à vide (mesuré au bench de l'étape 1, G.8).
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

textures/canvas_textures/default_texture_filter=0
; Machine cible : GPU intégré — shadow map directionnelle réduite (G.1 :
; architecturer pour la performance dès le jour 1).
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
