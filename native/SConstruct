#!/usr/bin/env python
# Build de l'extension voxen_native (GDExtension).
#
# Toolchain de cette machine (2026-08-09, AUCUN MSVC installé) :
#   - MinGW-w64 portable : C:/Users/ciryl/dev-tools/mingw64  (g++ 16.2)
#   - SCons : python -m SCons  (pip --user)
#   - godot-cpp branche 4.5 : C:/Users/ciryl/dev-tools/godot-cpp
#     (pas de branche 4.6/4.7 publiée — la compatibilité ascendante GDExtension
#     fait qu'une lib bâtie contre l'API 4.5 tourne sur le Godot 4.7 du projet ;
#     compatibility_minimum = "4.5" dans le .gdextension.)
#
# Commande (depuis native/), PATH préfixé du bin de MinGW :
#   python -m SCons platform=windows use_mingw=yes target=template_debug -j8
#
# `use_mingw` + liaison STATIQUE de la libstdc++/libgcc : la DLL doit se
# charger sur une machine sans MinGW dans le PATH.

import os

GODOT_CPP = os.environ.get("GODOT_CPP", "C:/Users/ciryl/dev-tools/godot-cpp")

env = SConscript(GODOT_CPP + "/SConstruct")

env.Append(CPPPATH=["src/"])
if env.get("use_mingw"):
    env.Append(LINKFLAGS=["-static", "-static-libgcc", "-static-libstdc++"])

# Pas de préfixe « lib » : le .gdextension nomme la DLL explicitement.
env["SHLIBPREFIX"] = ""

sources = Glob("src/*.cpp")
library = env.SharedLibrary(
    "bin/voxen_native{}{}".format(env["suffix"], env["SHLIBSUFFIX"]),
    source=sources,
)
Default(library)
