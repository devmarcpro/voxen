# Logs et captures générés par les benchs, sondes et tests (régénérables)
*.log
/debug/

# Dossier d'import de Godot
.godot/

# Caches Python des generateurs d assets (tools/*.py).
__pycache__/
*.pyc

# Reglages personnels de l outillage Claude (permissions locales, jamais
# partages — le fichier est reecrit par l outil lui-meme).
.claude/settings.local.json

# Artefacts de build de l extension native (native/) — la DLL se rebatit avec
# native/SConstruct (voir son en-tete pour la toolchain portable).
/native/bin/
/native/.sconsign.dblite
/native/src/*.o
/native/src/*.os
